# BRIGHTS — environment configuration example. Copy to backend/.env and fill in.
#
# By default BRIGHTS uses FREE, PUBLIC Yahoo Finance data (via the `yfinance` package)
# for IDX (.JK) tickers — NO API KEY REQUIRED. Just install requirements and run.
# The keys below are OPTIONAL and only enable extra licensed sources.

# Comma-separated source precedence. Default: yfinance,sectors,eodhd
# Leave as-is to use free Yahoo Finance data only.
DATA_SOURCE_PRIORITY=yfinance,sectors,eodhd

# ---------------------------------------------------------------------------
# OPTIONAL licensed sources (leave blank to run entirely on free Yahoo data)
# ---------------------------------------------------------------------------

# Sectors.app (Supertype) API key — https://sectors.app
# Licensed IDX/KSEI fundamentals & shareholder data. Optional.
SECTORS_API_KEY=

# EODHD API key — https://eodhd.com
# Free plan = EOD prices only (no fundamentals/shareholders). A paid "Fundamentals"
# plan is required for financial statements & ownership via EODHD. Optional.
EODHD_API_KEY=

# KSEI SID statistics — optional enrichment. MUST be a JSON endpoint returning e.g.
# {"total_sid": 14200000, "equity_sid": 6100000, "as_of_date": "2026-07-31"}
KSEI_STATISTICS_URL=

# ---------------------------------------------------------------------------
# Telegram Bot Integration (Optional)
# ---------------------------------------------------------------------------
# Telegram Bot Token from @BotFather for broadcasting daily stock recommendations
TELEGRAM_BOT_TOKEN=
# Telegram Chat ID or Channel ID to receive the daily recommendations
TELEGRAM_CHAT_ID=

